{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup Virtual Environment",
            "type": "shell",
            "command": "uv sync",
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Run Proxy",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m uvicorn main:app --host 0.0.0.0 --port 8080 --reload",
            "options": {
                "cwd": "${workspaceFolder}/services/copilot-proxy/src"
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Run UI",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m streamlit run ui.py --server.headless false",
            "options": {
                "cwd": "${workspaceFolder}/services/copilot-ui"
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Test Proxy",
            "type": "shell",
            "command": "uv run pytest tests/test_proxy.py",
            "options": {
                "cwd": "${workspaceFolder}/services/copilot-proxy"
            },
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Build Docker Image",
            "type": "shell",
            "command": "docker build -t copilot-proxy .",
            "options": {
                "cwd": "${workspaceFolder}/services/copilot-proxy"
            },
            "problemMatcher": [],
            "group": "build"
        }
    ]
}